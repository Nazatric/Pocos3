# LLVM is fetched at build time by scripts/fetch-llvm.sh (too big to ship).
# All other 3rdparty submodules (asmjit, hidapi, libpng, glslang, wolfssl,
# ffmpeg, curl, SDL, zstd, 7zip, protobuf, etc.) ARE inlined as committed
# source files. Do NOT ignore them.
/third_party/rpcs3/3rdparty/llvm/llvm/

