<?xml version="1.0" encoding="utf-8"?>
<!--
    PocoS3 AndroidManifest

    Permissions are deliberately minimal. PocoS3 does NOT request
    MANAGE_EXTERNAL_STORAGE by default; it uses Storage Access Framework
    (READ_EXTERNAL_STORAGE for legacy, plus SAF URIs for everything else).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required: enumerate and present Vulkan surface. -->
    <uses-feature android:name="android.hardware.vulkan.level" android:version="1" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.version"
        android:version="0x401000" android:required="true" /> <!-- Vulkan 1.3 -->

    <!-- Required: ARM64. PocoS3 does not ship other ABIs. -->
    <uses-feature android:name="android.hardware.arm64.v8a" android:required="true" />

    <!-- Optional: physical controllers. required=false so touch devices still install. -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usr.host" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />

    <!-- Storage: SAF-only by default. Legacy write only for API <= 28. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <!-- Audio: for Oboe AAudio backend. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Vibration: touch overlay rumble. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Bluetooth: physical controllers (post-Android 12 needs explicit). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Foreground service: emulator runtime. Type=mediaPlayback keeps audio
         alive in background; this is what Google Play expects for emulators. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Network: optional - only used if user enables cover-art fetching from a remote. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Large heap: PS3 emulator working set is large. 12 GB device has headroom. -->
    <application
        android:name=".PocoS3Application"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:requestLegacyExternalStorage="false"
        android:enableOnBackInvokedCallback="true"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:supportsRtl="false"
        android:theme="@style/Theme.PocoS3"
        tools:targetApi="35">

        <!-- Splash activity - shows the Mornye launch screen, then bounces to Main. -->
        <activity
            android:name=".BootSplashActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|density|uiMode|navigation|layoutDirection|locale|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PocoS3.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main activity: hosts Compose UI. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|density|uiMode|navigation|layoutDirection|locale|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PocoS3" />

        <!-- Emulation activity: hosts the Vulkan surface + touch overlay.
             Separate from Main so it can use immersive mode and a different
             orientation lock without affecting UI navigation state. -->
        <activity
            android:name=".EmulationActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|density|uiMode|navigation|layoutDirection|locale|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PocoS3.Fullscreen"
            android:preferMinimalPostProcessing="true" />

        <!-- Foreground service: emulator runtime. -->
        <service
            android:name=".runtime.EmulatorService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false" />

        <!-- File provider for sharing logs / crashes / screenshots. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

    </application>
</manifest>
